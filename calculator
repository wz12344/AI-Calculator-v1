<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Научный Калькулятор (Символьный Решатель, Дроби и Обучение AI)</title>
    <!-- Подключение Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- ПОДКЛЮЧЕНИЕ MATHJAX для правильного отображения LaTeX-формул -->
    <script>
        // Настройка MathJax
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']],
                processEscapes: true
            },
            options: {
                ignoreHtmlClass: 'tex2jax_ignore',
                processHtmlClass: 'tex2jax_process'
            }
        };
    </script>
    <script type="text/javascript" id="MathJax-script" async
        src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js">
    </script>
    <style>
        /* Настройка шрифта и фона */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #1f2937; /* Темный фон */
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 1rem;
        }
        /* Стиль кнопки */
        .calc-button {
            padding: 1rem 0;
            font-size: 1.25rem;
            font-weight: 600;
            transition: all 0.1s;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            line-height: 1.5rem;
        }
        .calc-button:active {
            transform: scale(0.98);
            box-shadow: none;
        }
        /* Анимация для сообщения об ошибке */
        .error-message {
            animation: fadeInOut 3s forwards;
            opacity: 0;
        }
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateY(10px); }
            10% { opacity: 1; transform: translateY(0); }
            90% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(-10px); }
        }
        /* Стиль для формул MathJax, чтобы они были видны на темном фоне */
        .MathJax span.mn, .MathJax span.mo, .MathJax span.mi, .MathJax span.TeXAtom {
            color: #d1d5db !important; /* Серый/светлый цвет для формул */
        }
        /* Скрываем стрелки у number input */
        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }
        /* Стиль для анимации загрузки */
        .loader {
            display: inline-block;
            width: 50px;
            height: 50px;
            border: 5px solid #4f46e5;
            border-radius: 50%;
            border-top-color: #a78bfa;
            animation: spin 1s ease-in-out infinite;
            margin: 0 auto;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

<div class="w-full max-w-lg space-y-8">
    
    <!-- 1. Научный Калькулятор (Интерактивный) -->
    <div id="calculator-main" class="bg-gray-800 rounded-3xl overflow-hidden shadow-2xl p-4 sm:p-6 border border-gray-700">
