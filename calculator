        }
    }

    // Хелпер для форматирования чисел с ограничением точности (для дискриминанта)
    function formatNumber(num) {
        if (typeof num !== 'number' || !isFinite(num)) return 'Error';
        const rounded = parseFloat(num.toFixed(8));
        return rounded.toString();
    }

    function calculateDiscriminant() {
        const a = parseFloat(inputA.value) || 0;
        const b = parseFloat(inputB.value) || 0;
        const c = parseFloat(inputC.value) || 0;
        
        if (typeof MathJax !== 'undefined') MathJax.typesetClear([discValue, rootsValue]);

        // 1. Не квадратное уравнение
        if (a === 0) {
            if (b === 0) {
                discValue.textContent = `$-$`;
                rootsValue.textContent = `$${formatNumber(c)} = 0$. ${c === 0 ? 'Бесконечное множество решений' : 'Нет решений'}`;
            } else {
                const x = -c / b;
                discValue.textContent = `$-$`;
                rootsValue.textContent = `$X = ${decimalToFraction(x)}$`;
            }
            if (typeof MathJax !== 'undefined') MathJax.typeset([discValue, rootsValue]);
            return;
        }

        // 2. Квадратное уравнение
        const D = b * b - 4 * a * c;
        discValue.textContent = `$D = ${decimalToFraction(D)}$`;
        
        let rootsText = '';

        if (D > 1e-10) { // D > 0
            const sqrtD = Math.sqrt(D);
            const x1 = (-b + sqrtD) / (2 * a);
            const x2 = (-b - sqrtD) / (2 * a);
            rootsText = `$X_1 = ${decimalToFraction(x1)}, \\quad X_2 = ${decimalToFraction(x2)}$`;
        } else if (Math.abs(D) < 1e-10) { // D ~= 0
            const x = -b / (2 * a);
            rootsText = `$X_1 = X_2 = ${decimalToFraction(x)}$`;
        } else {
            // Два комплексных корня (D < 0)
            const realPart = -b / (2 * a);
            const imagPart = Math.sqrt(-D) / (2 * a);
            const r = decimalToFraction(realPart);
            const i = decimalToFraction(imagPart);
            
            if (realPart === 0) {
                rootsText = `$X_{1,2} = \\pm ${i}i$`;
            } else {
                rootsText = `$X_{1,2} = ${r} \\pm ${i}i$`; 
            }
        }

        rootsValue.textContent = rootsText;

        if (typeof MathJax !== 'undefined') MathJax.typeset([discValue, rootsValue]);
    }

    // Привязываем обработчик ввода для автоматического пересчета
    inputA.addEventListener('input', calculateDiscriminant);
    inputB.addEventListener('input', calculateDiscriminant);
    inputC.addEventListener('input', calculateDiscriminant);


    // --- 2. ЛОГИКА AI-РЕШАТЕЛЯ ПО ФОТО ---

    let uploadedImageBase64 = null;
    
    const imagePreview = document.getElementById('image-preview');
    const imagePreviewContainer = document.getElementById('image-preview-container');
    const solveButton = document.getElementById('solve-button');
    const loadingIndicator = document.getElementById('loading-indicator');
    const aiResultContainer = document.getElementById('ai-result-container');
    const aiExpression = document.getElementById('ai-expression');
    const aiAnswer = document.getElementById('ai-answer');
    const aiSteps = document.getElementById('ai-steps');

    // Предпросмотр изображения и конвертация в Base64
    function previewImage(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            imagePreview.src = e.target.result;
            imagePreviewContainer.classList.remove('hidden');
            solveButton.disabled = false;
            
            const base64String = e.target.result.split(',')[1];
            const mimeType = file.type;
            uploadedImageBase64 = { data: base64String, mimeType: mimeType };
            
            aiResultContainer.classList.add('hidden');
            
            if (typeof MathJax !== 'undefined') {
                 MathJax.texReset();
                 MathJax.typesetClear([aiExpression, aiSteps]);
            }
        };
        reader.readAsDataURL(file);
    }

    // Вызов API Gemini для решения задачи (Vision)
    async function callGeminiVision(base64Data) {
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;

        const systemPrompt = "Вы являетесь высококлассным математическим решателем. Ваша задача — проанализировать изображение, извлечь математическое выражение, решить его и предоставить подробное пошаговое решение. Если задача простая (например, 1+1), шаги могут быть краткими. Для сложных задач (например, алгебра, уравнения, производные) предоставьте детальное разбиение решения. Вся выходная информация должна быть представлена в формате JSON, используя только русский язык. Обязательно используйте нотацию LaTeX, **заключенную в символы $**, для всех математических формул в полях 'expression_recognized' и 'solution_steps'. Не используйте двойные доллары ($$).";
        
        const userPrompt = "Распознай и реши эту математическую задачу. Предоставь полный текст распознанного выражения, окончательный ответ и пошаговое решение. ";

        const payload = {
            contents: [
                {
                    role: "user",
                    parts: [
                        { text: userPrompt },
                        {
                            inlineData: {
                                mimeType: base64Data.mimeType,
                                data: base64Data.data
                            }
                        }
                    ]
                }
            ],
            systemInstruction: {
                parts: [{ text: systemPrompt }]
            },
            generationConfig: {
                responseMimeType: "application/json",
                responseSchema: {
                    type: "OBJECT",
                    properties: {
                        "expression_recognized": { "type": "STRING", "description": "Распознанное математическое выражение или текст задачи в формате LaTeX, заключенном в $." },
                        "final_answer": { "type": "STRING", "description": "Окончательный ответ задачи." },
                        "solution_steps": { "type": "STRING", "description": "Полное пошаговое решение с формулами в формате LaTeX, заключенном в $." }
                    }
                }
            }
        };

        const maxRetries = 5;
        let delay = 1000;
        
        for (let i = 0; i < maxRetries; i++) {
            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const result = await response.json();
                    const jsonText = result.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (jsonText) {
                        return JSON.parse(jsonText);
                    }
                } else if (response.status === 429 || response.status >= 500) {
                    if (i < maxRetries - 1) {
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2; 
                    } else {
                        throw new Error(`Ошибка API после ${maxRetries} попыток.`);
                    }
                } else {
                    throw new Error(`Ошибка HTTP: ${response.status}`);
                }
            } catch (error) {
                if (i < maxRetries - 1) {
                    await new Promise(resolve => setTimeout(resolve, delay));
                    delay *= 2;
                } else {
                    throw new Error(`Ошибка сети/парсинга: ${error.message}`);
                }
            }
        }
        return null;
    }

    // Обработчик кнопки "Решить Задачу"
    async function solveImageProblem() {
        if (!uploadedImageBase64) {
            showMessage("Сначала загрузите изображение.");
            return;
        }

        aiResultContainer.classList.add('hidden');
        loadingIndicator.classList.remove('hidden');
        solveButton.disabled = true;
        
        if (typeof MathJax !== 'undefined') {
             MathJax.texReset();
             MathJax.typesetClear([aiExpression, aiSteps]);
        }

        try {
            const solution = await callGeminiVision(uploadedImageBase64);

            if (solution) {
                aiExpression.textContent = solution.expression_recognized || "Не распознано";
                aiAnswer.textContent = solution.final_answer || "Нет ответа";
                
                aiSteps.innerHTML = formatSolutionSteps(solution.solution_steps);
                
                aiResultContainer.classList.remove('hidden');

                if (typeof MathJax !== 'undefined') {
                    await MathJax.typesetPromise([aiExpression, aiSteps]);
                }

            } else {
                aiAnswer.textContent = "Не удалось получить решение от AI.";
                aiResultContainer.classList.remove('hidden');
            }
        } catch (error) {
            aiAnswer.textContent = `Ошибка: ${error.message}`;
            aiResultContainer.classList.remove('hidden');
            console.error("AI Solver Error:", error);
        } finally {
            loadingIndicator.classList.add('hidden');
            solveButton.disabled = false;
        }
    }

    // Простая функция для форматирования текста
    function formatSolutionSteps(text) {
        if (!text) return "Нет пошагового решения.";
        return text.replace(/\n\n/g, '<p class="mt-2"></p>').replace(/\n/g, '<br>');
    }
    
    // --- 3. ЛОГИКА ГЕНЕРАТОРА И ОБУЧЕНИЯ (НОВАЯ ФУНКЦИЯ LLM) ---
    
    async function callGeminiLesson(topic) {
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;

        const systemPrompt = `Ты - высококвалифицированный преподаватель математики, который предоставляет четкие, подробные объяснения и генерирует практические задачи. Отвечай только на русском языке. Для всех математических выражений и формул используй нотацию LaTeX, заключенную в символы $, но не используй $$. Сгенерируй детальное объяснение по заданной теме и создай ровно 3 (три) практические задачи с подробными решениями для закрепления материала.`;
        
        const userPrompt = `Создай подробный учебный материал по теме: "${topic}".`;

        const payload = {
            contents: [
                { role: "user", parts: [{ text: userPrompt }] }
            ],
            systemInstruction: {
                parts: [{ text: systemPrompt }]
            },
            generationConfig: {
                responseMimeType: "application/json",
                responseSchema: {
                    type: "OBJECT",
                    properties: {
                        "explanation_title": { "type": "STRING", "description": "Краткое, но исчерпывающее название темы." },
                        "explanation_text": { "type": "STRING", "description": "Подробное, легкое для понимания объяснение концепции." },
                        "practice_problems": {
                            "type": "ARRAY",
                            "description": "Список из 3 практических задач.",
                            "items": {
                                "type": "OBJECT",
                                "properties": {
                                    "problem": { "type": "STRING", "description": "Формулировка задачи в формате LaTeX, заключенном в $." },
                                    "solution": { "type": "STRING", "description": "Подробное пошаговое решение или окончательный ответ в формате LaTeX, заключенном в $." }
                                }
                            }
                        }
                    }
                }
            }
        };
        
        const maxRetries = 5;
        let delay = 1000;
        
        for (let i = 0; i < maxRetries; i++) {
            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const result = await response.json();
                    const jsonText = result.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (jsonText) {
                        return JSON.parse(jsonText);
                    }
                } else if (response.status === 429 || response.status >= 500) {
                    if (i < maxRetries - 1) {
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2; 
                    } else {
                        throw new Error(`Ошибка API после ${maxRetries} попыток.`);
                    }
                } else {
                    throw new Error(`Ошибка HTTP: ${response.status}`);
                }
            } catch (error) {
                if (i < maxRetries - 1) {
                    await new Promise(resolve => setTimeout(resolve, delay));
                    delay *= 2;
                } else {
                    // В случае ошибки парсинга, может быть невалидный JSON, но мы должны хотя бы показать ошибку
                    throw new Error(`Ошибка сети/парсинга: ${error.message}`);
                }
            }
        }
        return null;
    }
    
    // Основной обработчик для Генератора Задач
    async function generateMathLesson() {
        const topic = lessonTopicInput.value.trim();
        if (!topic) {
            showMessage("Пожалуйста, введите тему для урока.");
            return;
        }
        
        lessonResultContainer.classList.add('hidden');
        lessonLoadingIndicator.classList.remove('hidden');
        generateButton.disabled = true;

        // Очистка предыдущего MathJax
        if (typeof MathJax !== 'undefined') {
             MathJax.texReset();
             MathJax.typesetClear([lessonExplanation, lessonProblems]);
        }
        
        lessonProblems.innerHTML = '';
        
        try {
            const lessonData = await callGeminiLesson(topic);
            
            if (lessonData && lessonData.explanation_title) {
                lessonTitle.textContent = lessonData.explanation_title;
                lessonExplanation.textContent = lessonData.explanation_text;
                
                lessonProblems.innerHTML = '';
                
                lessonData.practice_problems.forEach((item, index) => {
                    const problemElement = document.createElement('div');
                    problemElement.className = 'border-t border-gray-600 pt-3';
                    
                    problemElement.innerHTML = `
                        <p class="text-gray-300 font-medium mb-2">Задача ${index + 1}:</p>
                        <p class="tex2jax_process text-white text-lg mb-2">${item.problem}</p>
                        <button class="show-solution-btn bg-yellow-600 hover:bg-yellow-700 text-white text-sm py-1 px-3 rounded-md transition duration-150" 
                                onclick="toggleSolution(this, 'solution-${index}')">
