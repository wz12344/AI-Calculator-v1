    <!-- 3. Секция Генератора и Обучения (Новая LLM функция) -->
    <div class="w-full bg-gray-800 rounded-3xl shadow-2xl p-4 sm:p-6 border border-gray-700">
        <h2 class="text-white text-center text-xl font-bold mb-4 border-b border-gray-700 pb-3">✨ Генератор Задач и Объяснений (Gemini AI)</h2>

        <div class="flex flex-col sm:flex-row gap-3 mb-4">
            <input type="text" id="lesson-topic" placeholder="Введите тему (напр., 'Производные' или 'Дроби')"
                   class="w-full p-3 rounded-xl bg-gray-900 text-white border border-gray-700 focus:ring-purple-500 focus:border-purple-500"
                   value="Квадратное уравнение">
            <button id="generate-button" onclick="generateMathLesson()" 
                    class="w-full sm:w-auto py-3 px-4 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-xl transition duration-200 shadow-md flex-shrink-0 disabled:opacity-50">
                Создать Урок
            </button>
        </div>

        <!-- Результат Генератора -->
        <div id="lesson-result-container" class="mt-4 p-4 bg-gray-700 rounded-xl hidden">
            <h3 id="lesson-title" class="text-yellow-400 text-xl font-bold mb-2"></h3>
            
            <p class="text-sm text-gray-400 mb-2">Объяснение Концепции:</p>
            <div id="lesson-explanation" class="tex2jax_process text-gray-300 whitespace-pre-wrap leading-relaxed bg-gray-800 p-3 rounded-lg text-sm mb-4"></div>

            <h4 class="text-gray-200 text-lg font-bold mb-3">Практические Задачи:</h4>
            <div id="lesson-problems" class="space-y-4">
                <!-- Problems will be injected here -->
            </div>
        </div>
        
        <div id="lesson-loading-indicator" class="hidden text-center text-purple-400 font-semibold py-4">
            <div class="loader mx-auto mb-2 w-8 h-8"></div>
            AI генерирует учебный материал...
