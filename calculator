                        </button>
                        <div id="solution-${index}" class="hidden mt-2 p-3 bg-gray-900 rounded-lg tex2jax_process">
                            <p class="text-sm text-gray-400 mb-1">Решение:</p>
                            <p class="text-green-400 text-lg">${item.solution}</p>
                        </div>
                    `;
                    lessonProblems.appendChild(problemElement);
                });
                
                lessonResultContainer.classList.remove('hidden');
                
                // Перерисовка MathJax для всех новых элементов
                if (typeof MathJax !== 'undefined') {
                    await MathJax.typesetPromise([lessonExplanation, lessonProblems]);
                }

            } else {
                showMessage("Не удалось сгенерировать материал. Попробуйте другой запрос.");
            }
        } catch (error) {
            showMessage(`Ошибка генерации: ${error.message}`);
            console.error("Lesson Generator Error:", error);
        } finally {
            lessonLoadingIndicator.classList.add('hidden');
            generateButton.disabled = false;
        }
    }
    
    // Функция для переключения видимости решения
    function toggleSolution(button, solutionId) {
        const solutionDiv = document.getElementById(solutionId);
        if (solutionDiv.classList.contains('hidden')) {
            solutionDiv.classList.remove('hidden');
            button.textContent = 'Скрыть Решение';
            button.classList.replace('bg-yellow-600', 'bg-red-600');
            button.classList.replace('hover:bg-yellow-700', 'hover:bg-red-700');
        } else {
            solutionDiv.classList.add('hidden');
            button.textContent = 'Показать Решение';
            button.classList.replace('bg-red-600', 'bg-yellow-600');
            button.classList.replace('hover:bg-red-700', 'hover:bg-yellow-700');
        }
    }
